    def load_wallpaper_paths(self):
        """
        Build the slideshow image list. Explicit filenames (in display order)
        are checked first so the slideshow always includes every named
        wallpaper regardless of glob/extension quirks (e.g. spaces in
        'wall 1080.png', mixed .jpg/.jpeg case). Anything else found in
        WALLPAPERS_DIR via glob is appended afterward, deduplicated.
        """
        named_files = [
            "background.png",
            "wall-4k.png",
            "wall-2k.png",
            "wall 1080.png",
            "splash.png",
            "hoodie.png",
            "hacktheplanet.png",
            "YOR.jpg",
            "blackarch.png",
            "Blue_cyber_theme_wallpaper_ARCXOS_202607261041.jpeg",
            "Cyber_wallpaper_ARCXOS_OS_blue_202607261052.jpeg",
            "Cyber_wallpaper_ARCXOS_OS_theme_202607261055.jpeg",
            "Green_hacker_wallpaper_ARCXOS_OS_202607261052.jpeg",
            "Woman_with_ARCXOS_text_2K_202607261040.jpeg",
        ]

        paths = []
        seen = set()

        for fname in named_files:
            fpath = os.path.join(WALLPAPERS_DIR, fname)
            if os.path.exists(fpath) and fpath not in seen:
                paths.append(fpath)
                seen.add(fpath)

        exts = ('*.png', '*.jpg', '*.jpeg', '*.webp', '*.PNG', '*.JPG', '*.JPEG', '*.WEBP')
        extra = []
        for ext in exts:
            extra.extend(glob.glob(os.path.join(WALLPAPERS_DIR, ext)))
        extra.sort()

        for fpath in extra:
            if "arcxoslogo" in os.path.basename(fpath).lower():
                continue
            if fpath not in seen:
                paths.append(fpath)
                seen.add(fpath)

        return paths

