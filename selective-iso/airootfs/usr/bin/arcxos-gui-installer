        succ_t.setFont(QFont(FONT_FAMILY, 15, QFont.Weight.Bold))
        succ_t.setStyleSheet(f"color: {COLOR_SUCCESS};")

        succ_d = QLabel("ArcXos Linux is now installed on your system. You can restart your computer into the new OS.")
        succ_d.setStyleSheet("color: #ffffff; font-size: 12px;")

        succ_txt_box.addWidget(succ_t)
        succ_txt_box.addWidget(succ_d)

        succ_layout.addWidget(succ_icon)
        succ_layout.addLayout(succ_txt_box)
        succ_layout.addStretch()

        layout.addWidget(succ_card)

        about_card = QFrame()
        about_card.setStyleSheet(f"background-color: {COLOR_SURFACE}; border: 1px solid {COLOR_BORDER}; border-radius: 8px; padding: 20px;")
        about_layout = QHBoxLayout(about_card)

        logo_lbl = QLabel()
        if os.path.exists(LOGO_PATH):
            logo_lbl.setPixmap(QPixmap(LOGO_PATH).scaled(140, 140, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation))
        about_layout.addWidget(logo_lbl)

        self.about_text_edit = QTextEdit()
        self.about_text_edit.setReadOnly(True)
        self.about_text_edit.setStyleSheet(f"background-color: {COLOR_BG}; color: {COLOR_TEXT}; border: 1px solid {COLOR_BORDER}; border-radius: 6px; font-family: monospace;")
        about_layout.addWidget(self.about_text_edit, 1)

        layout.addWidget(about_card, 1)

        self.check_reboot = QCheckBox("Reboot system now automatically")
        self.check_reboot.setChecked(True)
        self.check_reboot.setFont(QFont(FONT_FAMILY, 12, QFont.Weight.Bold))
        layout.addWidget(self.check_reboot)

        return page

    def populate_about_details(self):
        username = self.input_username.text()
        hostname = self.input_hostname.text()
        disk = self.disk_combo.currentData()
        timezone = self.city_combo.currentData()

        about_content = f"""=====================================================
            ArcXos Linux Slim Edition
=====================================================
Lead Developer & Creator : Arunachalam
Project Name             : ArcXos Linux OS
Installation Type        : 100% Offline Standalone Deployment

--- Installed System Configuration ---
Target Disk Device       : {disk}
Bootloader Mode          : {self.boot_mode} (GRUB)
Configured Timezone      : {timezone}
Primary User Account     : {username}
Host System Name         : {hostname}
Desktop Environment      : XFCE4 Dark Custom
Kernel Package           : Hardened Linux (vmlinuz-linux)
=====================================================
Thank you for installing ArcXos Linux!
"""
        self.about_text_edit.setText(about_content)

    # Navigation Logic
    def go_next(self):
        cur_idx = self.stacked_widget.currentIndex()

        if cur_idx == 3:
            p1 = self.input_pass.text()
            p2 = self.input_pass_confirm.text()
            if p1 != p2:
                QMessageBox.warning(self, "Password Mismatch", "Passwords do not match. Please enter matching passwords.")
                return

            reply = QMessageBox.question(
                self, "Confirm Installation",
                "Are you ready to begin installation?\nTarget disk partitions will be modified.",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
            )
            if reply == QMessageBox.StandardButton.Yes:
                self.stacked_widget.setCurrentIndex(4)
                self.update_step_indicator(4)
                self.start_installation()
        elif cur_idx == 5:
            if self.check_reboot.isChecked():
                subprocess.run(["reboot"])
            self.close()
        else:
            new_idx = cur_idx + 1
            self.stacked_widget.setCurrentIndex(new_idx)
            self.update_step_indicator(new_idx)

    def go_back(self):
        cur_idx = self.stacked_widget.currentIndex()
        if cur_idx > 0:
            new_idx = cur_idx - 1
            self.stacked_widget.setCurrentIndex(new_idx)
            self.update_step_indicator(new_idx)


def main():
    if os.geteuid() != 0:
        print("[!] Error: ArcXos Installer must be run as root (sudo arcxos-gui-installer).")
        sys.exit(1)

    app = QApplication(sys.argv)
    window = ArcXosInstallerWindow()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
