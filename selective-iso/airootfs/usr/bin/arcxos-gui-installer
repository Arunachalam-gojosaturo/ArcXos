        # Bottom Controls Navigation
        bottom_bar = QFrame()
        bottom_bar.setStyleSheet(f"background-color: {COLOR_SURFACE}; border-top: 1px solid {COLOR_BORDER};")
        bottom_layout = QHBoxLayout(bottom_bar)
        bottom_layout.setContentsMargins(24, 14, 24, 14)

        self.btn_back = QPushButton("< Back")
        self.btn_back.clicked.connect(self.go_back)
        self.btn_back.setEnabled(False)

        self.btn_next = QPushButton("Next >")
        self.btn_next.setObjectName("PrimaryBtn")
        self.btn_next.clicked.connect(self.go_next)
        apply_glow(self.btn_next, color=COLOR_PRIMARY, radius=16, alpha=140)

        btn_cancel = QPushButton("Cancel")
        btn_cancel.clicked.connect(self.close)

        bottom_layout.addWidget(btn_cancel)
        bottom_layout.addStretch()
        bottom_layout.addWidget(self.btn_back)
        bottom_layout.addWidget(self.btn_next)

        content_layout.addWidget(bottom_bar)
        main_h_layout.addWidget(content_area, 1)

    def open_about_dialog(self):
        dlg = AboutDialog(self)
        dlg.exec()

    def update_step_indicator(self, index):
        headers = [
            ("Welcome to ArcXos Linux", "Slim Edition — Elite Cybersecurity & Penetration Testing OS"),
            ("Timezone & Region Selection", "Click your country on the world map or select location from dropdown"),
            ("Storage & Disk Selection", "Choose target disk, dual boot or custom partition configuration"),
            ("User Credentials", "Configure account username, computer hostname and security password"),
            ("Installing System Image", "Deploying system files directly from offline image"),
            ("Installation Complete", "ArcXos Linux has been successfully deployed")
        ]

        if index < len(headers):
            title, desc = headers[index]
            self.page_header_title.setText(title)
            self.page_header_desc.setText(desc)

        for i, lbl in enumerate(self.step_labels):
            if i == index:
                lbl.setObjectName("SidebarStepItemActive")
            else:
                lbl.setObjectName("SidebarStepItem")
            lbl.setStyle(lbl.style())

        self.btn_back.setEnabled(index > 0 and index < 4)
        if index == 4:
            self.btn_back.setEnabled(False)
            self.btn_next.setEnabled(False)
            self.btn_next.setText("Installing...")
        elif index == 5:
            self.btn_back.setEnabled(False)
            self.btn_next.setEnabled(True)
            self.btn_next.setText("Finish & Reboot")
        else:
            self.btn_next.setEnabled(True)
            self.btn_next.setText("Next >")

