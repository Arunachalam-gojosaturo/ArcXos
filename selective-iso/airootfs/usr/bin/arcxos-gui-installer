    # ==========================================
    # Page 5: Installation & Animated Slideshow
    # ==========================================
    def create_page_installing(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(20, 20, 20, 20)

        # Upper Container: Wallpaper Slideshow
        self.slideshow_frame = QFrame()
        self.slideshow_frame.setStyleSheet(f"background-color: {COLOR_SURFACE}; border: 1px solid {COLOR_BORDER}; border-radius: 10px;")
        slide_layout = QVBoxLayout(self.slideshow_frame)
        slide_layout.setContentsMargins(0, 0, 0, 0)

        self.slide_img_lbl = QLabel()
        self.slide_img_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.slide_img_lbl.setMinimumHeight(320)
        slide_layout.addWidget(self.slide_img_lbl, 1)

        # Feature Text Overlay
        self.slide_title_lbl = QLabel("ArcXos Cyber Security OS")
        self.slide_title_lbl.setFont(QFont(FONT_FAMILY, 16, QFont.Weight.Bold))
        self.slide_title_lbl.setStyleSheet(f"color: {COLOR_PRIMARY}; background-color: rgba(13, 17, 23, 0.85); padding: 8px 16px;")

        self.slide_desc_lbl = QLabel("Installing system files offline...")
        self.slide_desc_lbl.setStyleSheet("color: #ffffff; background-color: rgba(13, 17, 23, 0.85); padding: 4px 16px 10px 16px; font-size: 13px;")

        slide_layout.addWidget(self.slide_title_lbl)
        slide_layout.addWidget(self.slide_desc_lbl)

        layout.addWidget(self.slideshow_frame, 1)

        # Progress Bar & Logs
        self.progress_bar = QProgressBar()
        self.progress_bar.setValue(0)
        self.progress_bar.setFixedHeight(24)
        layout.addWidget(self.progress_bar)

        self.status_lbl = QLabel("Preparing installation...")
        self.status_lbl.setFont(QFont(FONT_FAMILY, 11, QFont.Weight.Bold))
        self.status_lbl.setStyleSheet(f"color: {COLOR_PRIMARY};")
        layout.addWidget(self.status_lbl)

        self.slideshow_timer = QTimer(self)
        self.slideshow_timer.timeout.connect(self.rotate_slideshow)

        return page

    def start_installation(self):
        selected_disk = self.disk_combo.currentData() or "/dev/sda"
        part_option = self.part_button_group.checkedId()
        username = self.input_username.text().strip() or "arunachalam"
        password = self.input_pass.text() or "arcx"
        hostname = self.input_hostname.text().strip() or "arcxos"
        timezone = self.city_combo.currentData() or "UTC"

        config = {
            "disk": selected_disk,
            "boot_mode": self.boot_mode,
            "part_option": part_option,
            "username": username,
            "password": password,
            "hostname": hostname,
            "timezone": timezone
        }

        self.rotate_slideshow()
        self.slideshow_timer.start(5000)

        self.worker = InstallWorkerThread(config)
        self.worker.progressChanged.connect(self.on_install_progress)
        self.worker.installationFinished.connect(self.on_install_finished)
        self.worker.start()

    def rotate_slideshow(self):
        if not self.wallpapers:
            return

        wp_path = self.wallpapers[self.slideshow_index % len(self.wallpapers)]
        text_title, text_desc = SLIDESHOW_TEXTS[self.slideshow_index % len(SLIDESHOW_TEXTS)]

        pix = QPixmap(wp_path)
        if not pix.isNull():
            scaled = pix.scaled(self.slideshow_frame.size(), Qt.AspectRatioMode.KeepAspectRatioByExpanding, Qt.TransformationMode.SmoothTransformation)
            self.slide_img_lbl.setPixmap(scaled)

        self.slide_title_lbl.setText(text_title)
        self.slide_desc_lbl.setText(text_desc)

        self.slideshow_index += 1

    def on_install_progress(self, percent, msg):
        self.progress_bar.setValue(percent)
        self.status_lbl.setText(f"Status: {msg}")

    def on_install_finished(self, success, result_msg):
        self.slideshow_timer.stop()
        if success:
            self.stacked_widget.setCurrentIndex(5)
            self.update_step_indicator(5)
            self.populate_about_details()
        else:
            QMessageBox.critical(self, "Installation Error", f"Installation failed:\n{result_msg}")

    # ==========================================
    # Page 6: Finish & About Page
    # ==========================================
    def create_page_finish(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(30, 20, 30, 20)

        succ_card = QFrame()
        succ_card.setStyleSheet(f"background-color: #12281e; border: 1px solid {COLOR_SUCCESS}; border-radius: 8px; padding: 14px;")
