def run_command_output(cmd):
    """Run shell command and return stdout string."""
    try:
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=30)
        return res.stdout.strip()
    except Exception as e:
        return ""


def get_boot_mode():
    if os.path.exists("/sys/firmware/efi"):
        return "UEFI"
    return "BIOS (Legacy)"


def get_available_disks():
    """Scan available disks using lsblk."""
    disks = []
    output = run_command_output("lsblk -dno NAME,SIZE,MODEL,TYPE | grep -E 'disk'")
    for line in output.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            name = parts[0]
            size = parts[1]
            model = " ".join(parts[2:]) if len(parts) > 2 else "Drive"
            dev_path = f"/dev/{name}"
            disks.append({
                "dev": dev_path,
                "name": name,
                "size": size,
                "model": model
            })
    return disks


def get_disk_partitions(disk_dev):
    """Get list of partitions on selected disk."""
    parts = []
    output = run_command_output(f"lsblk -lno NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS '{disk_dev}' | grep -E '[0-9]+'")
    for line in output.splitlines():
        tokens = line.split()
        if tokens:
            p_name = tokens[0]
            p_size = tokens[1] if len(tokens) > 1 else "Unknown"
            p_fs = tokens[2] if len(tokens) > 2 else "raw"
            p_path = f"/dev/{p_name}"
            parts.append({
                "dev": p_path,
                "name": p_name,
                "size": p_size,
                "fs": p_fs
            })
    return parts


# ==========================================
# World Map Widget for Timezone Selection
# ==========================================
class WorldMapWidget(QWidget):
    timezoneSelected = pyqtSignal(str, str) # city, zone

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setMinimumHeight(240)
        self.selected_city = CITIES_DB[0]
        self.setMouseTracking(True)
        self.hovered_city = None

    def set_selected_city_by_zone(self, zone_name):
        for c in CITIES_DB:
            if c["zone"] == zone_name:
                self.selected_city = c
                self.update()
                break

    def mousePressEvent(self, event):
        w = self.width()
        h = self.height()
        click_x = event.position().x()
        click_y = event.position().y()

        closest_city = None
        min_dist = 999999

        for c in CITIES_DB:
            # Map lon (-180..180) -> (0..w)
            cx = (c["lon"] + 180) * (w / 360.0)
            # Map lat (90..-90) -> (0..h)
            cy = (90 - c["lat"]) * (h / 180.0)

            dist = math.hypot(click_x - cx, click_y - cy)
            if dist < min_dist:
                min_dist = dist
                closest_city = c

        if closest_city and min_dist < 40:
            self.selected_city = closest_city
            self.timezoneSelected.emit(closest_city["city"], closest_city["zone"])
            self.update()

    def mouseMoveEvent(self, event):
        w = self.width()
        h = self.height()
        mx = event.position().x()
        my = event.position().y()

        closest = None
        min_d = 9999

        for c in CITIES_DB:
            cx = (c["lon"] + 180) * (w / 360.0)
            cy = (90 - c["lat"]) * (h / 180.0)
            d = math.hypot(mx - cx, my - cy)
            if d < min_d:
                min_d = d
                closest = c

        if closest and min_d < 30:
            if self.hovered_city != closest:
                self.hovered_city = closest
                self.setCursor(Qt.CursorShape.PointingHandCursor)
                self.update()
        else:
            if self.hovered_city is not None:
                self.hovered_city = None
                self.unsetCursor()
                self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        w = self.width()
        h = self.height()

        # Canvas background (Deep Ocean Blue)
        grad = QLinearGradient(0, 0, 0, h)
        grad.setColorAt(0, QColor("#09101d"))
        grad.setColorAt(1, QColor("#121b2b"))
        painter.fillRect(0, 0, w, h, grad)

        # Draw Latitude/Longitude Grid Lines
        grid_pen = QPen(QColor("#1f2e46"), 1, Qt.PenStyle.DotLine)
        painter.setPen(grid_pen)

        for lon in range(-180, 181, 45):
            x = (lon + 180) * (w / 360.0)
            painter.drawLine(int(x), 0, int(x), h)

        for lat in range(-90, 91, 30):
            y = (90 - lat) * (h / 180.0)
            painter.drawLine(0, int(y), w, int(y))

        # Equator & Prime Meridian Highlight
        eq_y = (90 - 0) * (h / 180.0)
        pm_x = (0 + 180) * (w / 360.0)
        painter.setPen(QPen(QColor("#2d4365"), 1, Qt.PenStyle.SolidLine))
        painter.drawLine(0, int(eq_y), w, int(eq_y))
        painter.drawLine(int(pm_x), 0, int(pm_x), h)

        # Simple stylized continent outline approximations
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QBrush(QColor("#1e2c40")))

        # Landmass approximations (rects & polygons for high-tech map aesthetic)
        continents = [
            # North America
            [(20, 20), (120, 20), (110, 80), (60, 90), (30, 60)],
            # South America
            [(70, 100), (100, 100), (90, 160), (75, 175), (65, 120)],
            # Europe
            [(160, 30), (210, 30), (210, 65), (170, 70)],
            # Africa
            [(165, 75), (215, 75), (220, 130), (190, 160), (165, 110)],
            # Asia
            [(215, 20), (330, 20), (340, 100), (240, 100), (215, 60)],
            # Australia
            [(290, 120), (340, 120), (335, 160), (295, 160)]
        ]

        for poly in continents:
            pts = []
            for px, py in poly:
                # Convert 0..360, 0..180 approx coords
                wx = px * (w / 360.0)
                wy = py * (h / 180.0)
                pts.append(QPointF(wx, wy))
            painter.drawPolygon(pts)

        # Draw City Nodes
        for c in CITIES_DB:
            cx = (c["lon"] + 180) * (w / 360.0)
            cy = (90 - c["lat"]) * (h / 180.0)

            is_selected = (c == self.selected_city)
            is_hovered = (c == self.hovered_city)

            if is_selected:
                # Glowing selected pin
                rad = QRadialGradient(cx, cy, 18)
                rad.setColorAt(0, QColor(0, 243, 255, 200))
                rad.setColorAt(1, QColor(0, 243, 255, 0))
                painter.setBrush(QBrush(rad))
                painter.drawEllipse(QPointF(cx, cy), 18, 18)

                painter.setBrush(QBrush(QColor(COLOR_PRIMARY)))
                painter.setPen(QPen(QColor("#ffffff"), 2))
                painter.drawEllipse(QPointF(cx, cy), 6, 6)

                # Label tag
                painter.setPen(QPen(QColor("#ffffff")))
                painter.setFont(QFont(FONT_FAMILY, 9, QFont.Weight.Bold))
                tag_text = f"📍 {c['city']} ({c['zone']})"
                painter.drawText(int(cx) + 10, int(cy) - 8, tag_text)

            elif is_hovered:
                painter.setBrush(QBrush(QColor(COLOR_PRIMARY_HOVER)))
                painter.setPen(QPen(QColor("#ffffff"), 1))
                painter.drawEllipse(QPointF(cx, cy), 5, 5)
            else:
                painter.setBrush(QBrush(QColor("#4e6587")))
                painter.setPen(Qt.PenStyle.NoPen)
                painter.drawEllipse(QPointF(cx, cy), 3, 3)

        painter.end()


