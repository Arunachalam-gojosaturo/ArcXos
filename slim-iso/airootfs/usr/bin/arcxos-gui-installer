    def load_wallpaper_paths(self):
        exts = ('*.png', '*.jpg', '*.jpeg', '*.webp', '*.PNG', '*.JPG', '*.JPEG', '*.WEBP')
        paths = []
        for ext in exts:
            paths.extend(glob.glob(os.path.join(WALLPAPERS_DIR, ext)))
        paths.sort()
        # Exclude logo from wallpapers slideshow if present
        return [p for p in paths if "arcxoslogo" not in os.path.basename(p).lower()]

    def init_ui(self):
        main_widget = QWidget()
        self.setCentralWidget(main_widget)
        main_layout = QVBoxLayout(main_widget)
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.setSpacing(0)

